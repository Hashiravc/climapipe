# ==============================================================================
# ClimaData Perú - Environment Configuration (.env.example)
# Copia este archivo como .env y completa con tus credenciales reales de Neon.
# NUNCA compartas ni subas tu archivo .env al control de versiones.
# ==============================================================================

# --- CONEXIÓN PRINCIPAL A NEON POSTGRESQL (ESCRITURA / PIPELINE) ---
# Formato estándar de connection string de Neon:
# postgresql://<user>:<password>@<ep-project-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:tu_password_aqui@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Parámetros desglosados (utilizados por dbt profiles.yml y utilitarios):
DB_HOST=ep-cool-sample-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=tu_password_aqui
DB_SSLMODE=require

# --- CONEXIÓN DE SOLO LECTURA (PARA STREAMLIT DASHBOARD) ---
# Rol con permisos exclusivos SELECT en los esquemas raw y marts
DB_READONLY_USER=streamlit_reader
DB_READONLY_PASSWORD=tu_password_readonly_aqui

# --- CONFIGURACIÓN DEL PIPELINE ---
# Modos: 'initial' (backfill histórico) o 'incremental' (últimos N días)
PIPELINE_MODE=incremental
BACKFILL_START_DATE=2022-01-01
BACKFILL_END_DATE=2024-12-31
INCREMENTAL_DAYS_LOOKBACK=15

# Variables climáticas de Open-Meteo
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_SECONDS=30
OPEN_METEO_MAX_RETRIES=4

# Configuración de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
